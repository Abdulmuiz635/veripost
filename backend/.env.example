# ---- Server ----
PORT=8080
NODE_ENV=development

# ---- Database ----
# SQLite by default (zero infra). File lives at prisma/dev.db.
DATABASE_URL="file:./dev.db"
# For Postgres instead: set schema.prisma provider to "postgresql" and use e.g.
# DATABASE_URL="postgresql://veripost:veripost@localhost:5433/veripost?schema=public"

# ---- NIPOST API ----
# Leave NIPOST_API_KEY blank (or set NIPOST_MODE=mock) to run on the built-in
# sandbox fixtures. Set a real test/live secret key to call the live API.
NIPOST_MODE=auto               # auto | mock | live
NIPOST_API_BASE=https://api.postcode.gov.ng/v1
NIPOST_API_KEY=

# ---- Security ----
# Used to sign the Verified Address Record (VAR) JWT. Change this.
JWT_SIGNING_KEY=dev-change-me-to-a-long-random-string
# Admin token the VeriPost dashboard uses to read logs and manage keys.
ADMIN_API_TOKEN=dev-admin-token-change-me

# ---- Scoring thresholds (optional overrides) ----
SCORE_VERIFIED_MIN=75
SCORE_FLAGGED_MIN=40
